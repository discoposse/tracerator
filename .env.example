# Copy to .env in the repository root and fill in values.
# Docker Compose loads this file automatically for variable substitution and container env.

# Required for AIPerf replay when the tokenizer/model is gated on Hugging Face.
# Your shell profile alone is not enough — Compose needs the token here or exported
# in the same terminal where you run `docker compose up`.
HF_TOKEN=

# Optional OpenAI cloud key for other tools. Tracerator does NOT forward sk-/sk-proj
# keys to local MLX/vLLM replay (they cause "Invalid API key").
OPENAI_API_KEY=

# Default UI backend: omlx | vllm | sglang | ollama | openai
# TRACERATOR_INFERENCE_BACKEND=omlx

# Local inference auth for oMLX (Settings → API Key). Export on the host or set here.
# Compose passes this into the container — required when oMLX has a custom key.
# OMLX_API_KEY=
# Optional per-backend keys:
# VLLM_API_KEY=
# SGLANG_API_KEY=
# TRACERATOR_INFERENCE_API_KEY=
# LLM_API_KEY=

# Optional Hugging Face alias (defaults to HF_TOKEN when unset).
# HUGGING_FACE_HUB_TOKEN=

# Optional: override the host Hugging Face cache directory mounted into the container.
# TRACERATOR_HF_CACHE_DIR=${HOME}/.cache/huggingface

# Optional: host/port for inference replay from inside Docker (default host.docker.internal).
# TRACERATOR_INFERENCE_HOST=host.docker.internal

# Optional sibling checkouts for extra baseline traces. Leave unset to use
# ./external/<name> inside this repository (empty dirs are fine).
# TRACERATOR_RAGPULSE_DIR=./external/RAGPulse
# TRACERATOR_CC_WEKA_DIR=./external/cc-traces-weka-with-subagents-051826
# TRACERATOR_AIPERF_TOOLKIT_DIR=./external/aiperf-toolkit
# TRACERATOR_SAGESERVE_DIR=./external/SageServe
